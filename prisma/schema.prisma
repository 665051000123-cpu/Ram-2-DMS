generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model auditlog {
  id         String          @id
  action     auditlog_action
  documentId String?
  userId     String?
  details    String?
  createdAt  DateTime        @default(now())
  document   document?       @relation(fields: [documentId], references: [id], map: "AuditLog_documentId_fkey")
  user       user?           @relation(fields: [userId], references: [id], map: "AuditLog_userId_fkey")

  @@index([documentId], map: "AuditLog_documentId_fkey")
  @@index([userId], map: "AuditLog_userId_fkey")
}

model comment {
  id         String   @id
  text       String   @db.Text
  documentId String
  userId     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime
  document   document @relation(fields: [documentId], references: [id], onDelete: Cascade, map: "Comment_documentId_fkey")
  user       user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Comment_userId_fkey")

  @@index([documentId], map: "Comment_documentId_fkey")
  @@index([userId], map: "Comment_userId_fkey")
}

model department {
  id                                         String         @id
  name                                       String         @unique(map: "Department_name_key")
  createdAt                                  DateTime       @default(now())
  updatedAt                                  DateTime
  document_document_departmentIdTodepartment document[]     @relation("document_departmentIdTodepartment")
  documenttype                               documenttype[]
  folder                                     folder[]
  folderaccess                               folderaccess[]
  user                                       user[]
  document_documentshareddepartments         document[]     @relation("documentshareddepartments")
}

model document {
  id                                           String              @id
  title                                        String
  description                                  String?
  fileUrl                                      String
  fileType                                     String
  tags                                         String
  departmentId                                 String
  uploaderId                                   String
  createdAt                                    DateTime            @default(now())
  updatedAt                                    DateTime
  currentVersion                               Int                 @default(1)
  documentType                                 String?
  deletedAt                                    DateTime?
  isDeleted                                    Boolean             @default(false)
  fileSize                                     Int                 @default(0)
  extractedText                                String?             @db.LongText
  storagePath                                  String?
  folderId                                     String?
  documentCode                                 String?             @unique(map: "Document_documentCode_key")
  isExpired                                    Boolean             @default(false)
  retentionPeriod                              DateTime?
  customFields                                 Json?
  documentTypeId                               String?
  visibility                                   document_visibility @default(PRIVATE)
  auditlog                                     auditlog[]
  comment                                      comment[]
  department_document_departmentIdTodepartment department          @relation("document_departmentIdTodepartment", fields: [departmentId], references: [id], map: "Document_departmentId_fkey")
  documenttype                                 documenttype?       @relation(fields: [documentTypeId], references: [id], map: "Document_documentTypeId_fkey")
  folder                                       folder?             @relation(fields: [folderId], references: [id], map: "Document_folderId_fkey")
  user                                         user                @relation(fields: [uploaderId], references: [id], map: "Document_uploaderId_fkey")
  documentaccess                               documentaccess[]
  documentlink_documentlink_sourceIdTodocument documentlink[]      @relation("documentlink_sourceIdTodocument")
  documentlink_documentlink_targetIdTodocument documentlink[]      @relation("documentlink_targetIdTodocument")
  documentversion                              documentversion[]
  externalshare                                externalshare[]
  favorite                                     favorite[]
  department_documentshareddepartments         department[]        @relation("documentshareddepartments")

  @@index([departmentId], map: "Document_departmentId_fkey")
  @@index([documentTypeId], map: "Document_documentTypeId_fkey")
  @@index([folderId], map: "Document_folderId_fkey")
  @@index([uploaderId], map: "Document_uploaderId_fkey")
}

model documentaccess {
  id         String   @id
  documentId String
  userId     String
  canEdit    Boolean  @default(false)
  createdAt  DateTime @default(now())
  document   document @relation(fields: [documentId], references: [id], onDelete: Cascade, map: "DocumentAccess_documentId_fkey")
  user       user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "DocumentAccess_userId_fkey")

  @@unique([documentId, userId], map: "DocumentAccess_documentId_userId_key")
  @@index([userId], map: "DocumentAccess_userId_fkey")
}

model documentlink {
  id                                       String   @id
  sourceId                                 String
  targetId                                 String
  createdAt                                DateTime @default(now())
  document_documentlink_sourceIdTodocument document @relation("documentlink_sourceIdTodocument", fields: [sourceId], references: [id], onDelete: Cascade, map: "DocumentLink_sourceId_fkey")
  document_documentlink_targetIdTodocument document @relation("documentlink_targetIdTodocument", fields: [targetId], references: [id], onDelete: Cascade, map: "DocumentLink_targetId_fkey")

  @@unique([sourceId, targetId], map: "DocumentLink_sourceId_targetId_key")
  @@index([targetId], map: "DocumentLink_targetId_fkey")
}

model documenttype {
  id           String      @id
  name         String
  description  String?
  departmentId String?
  visibleTo    Json?
  schema       Json
  createdAt    DateTime    @default(now())
  updatedAt    DateTime
  document     document[]
  department   department? @relation(fields: [departmentId], references: [id], map: "DocumentType_departmentId_fkey")

  @@index([departmentId], map: "DocumentType_departmentId_fkey")
}

model documentversion {
  id            String   @id
  documentId    String
  version       Int
  fileUrl       String
  fileType      String
  uploaderId    String
  createdAt     DateTime @default(now())
  fileSize      Int      @default(0)
  extractedText String?  @db.LongText
  storagePath   String?
  document      document @relation(fields: [documentId], references: [id], onDelete: Cascade, map: "DocumentVersion_documentId_fkey")
  user          user     @relation(fields: [uploaderId], references: [id], map: "DocumentVersion_uploaderId_fkey")

  @@index([documentId], map: "DocumentVersion_documentId_fkey")
  @@index([uploaderId], map: "DocumentVersion_uploaderId_fkey")
}

model externalshare {
  id         String    @id
  documentId String
  token      String    @unique(map: "ExternalShare_token_key")
  password   String?
  expiresAt  DateTime?
  createdBy  String
  createdAt  DateTime  @default(now())
  viewCount  Int       @default(0)
  user       user      @relation(fields: [createdBy], references: [id], onDelete: Cascade, map: "ExternalShare_createdBy_fkey")
  document   document  @relation(fields: [documentId], references: [id], onDelete: Cascade, map: "ExternalShare_documentId_fkey")

  @@index([createdBy], map: "ExternalShare_createdBy_fkey")
  @@index([documentId], map: "ExternalShare_documentId_fkey")
}

model favorite {
  id         String   @id
  userId     String
  documentId String
  createdAt  DateTime @default(now())
  document   document @relation(fields: [documentId], references: [id], onDelete: Cascade, map: "Favorite_documentId_fkey")
  user       user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Favorite_userId_fkey")

  @@unique([userId, documentId], map: "Favorite_userId_documentId_key")
  @@index([documentId], map: "Favorite_documentId_fkey")
}

model folder {
  id           String         @id
  name         String
  description  String?
  departmentId String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime
  parentId     String?
  document     document[]
  department   department?    @relation(fields: [departmentId], references: [id], map: "Folder_departmentId_fkey")
  folder       folder?        @relation("folderTofolder", fields: [parentId], references: [id], map: "Folder_parentId_fkey")
  other_folder folder[]       @relation("folderTofolder")
  folderaccess folderaccess[]

  @@index([departmentId], map: "Folder_departmentId_fkey")
  @@index([parentId], map: "Folder_parentId_fkey")
}

model folderaccess {
  id           String             @id
  folderId     String
  departmentId String?
  createdAt    DateTime           @default(now())
  role         folderaccess_role?
  userId       String?
  department   department?        @relation(fields: [departmentId], references: [id], onDelete: Cascade, map: "FolderAccess_departmentId_fkey")
  folder       folder             @relation(fields: [folderId], references: [id], onDelete: Cascade, map: "FolderAccess_folderId_fkey")
  user         user?              @relation(fields: [userId], references: [id], onDelete: Cascade, map: "FolderAccess_userId_fkey")

  @@index([departmentId], map: "FolderAccess_departmentId_fkey")
  @@index([folderId], map: "FolderAccess_folderId_fkey")
  @@index([userId], map: "FolderAccess_userId_fkey")
}

model notification {
  id        String   @id
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Notification_userId_fkey")

  @@index([userId], map: "Notification_userId_fkey")
}

model systemsetting {
  id        String   @id
  key       String   @unique(map: "SystemSetting_key_key")
  value     String   @db.Text
  updatedAt DateTime
}

model user {
  id                  String            @id
  email               String            @unique(map: "User_email_key")
  passwordHash        String
  name                String
  role                user_role         @default(STAFF)
  departmentId        String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime
  forcePasswordChange Boolean           @default(true)
  notifyOnShare       Boolean           @default(true)
  notifyOnUpload      Boolean           @default(true)
  isActive            Boolean           @default(true)
  auditlog            auditlog[]
  comment             comment[]
  document            document[]
  documentaccess      documentaccess[]
  documentversion     documentversion[]
  externalshare       externalshare[]
  favorite            favorite[]
  folderaccess        folderaccess[]
  notification        notification[]
  department          department?       @relation(fields: [departmentId], references: [id], map: "User_departmentId_fkey")

  @@index([departmentId], map: "User_departmentId_fkey")
}

enum auditlog_action {
  UPLOAD
  VIEW
  DOWNLOAD
  EDIT
  DELETE
  RESTORE_VERSION
}

enum folderaccess_role {
  SUPER_ADMIN
  DEPT_HEAD
  STAFF
}

enum user_role {
  SUPER_ADMIN
  DEPT_HEAD
  STAFF
}

enum document_visibility {
  PRIVATE
  PUBLIC
  CUSTOM
}
